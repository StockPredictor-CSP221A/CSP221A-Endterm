# Development backend image.
#
# Published as :dev (slim) on every push to the dev branch, and as :dev-ml
# when the Publish Dev Images workflow is run manually.
#
# Run it with the source bind-mounted at /app (see compose.yaml). Dependencies
# live in /opt/venv so the bind mount does not hide them.
FROM python:3.12-slim

ARG INCLUDE_ML=false

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    HF_HOME=/home/appuser/.cache/huggingface \
    PORT=8000

WORKDIR /app

RUN pip install --no-cache-dir uv==0.11.31 \
    && useradd --create-home --uid 1000 appuser

COPY pyproject.toml uv.lock ./

# The dev dependency group (pytest, ruff) is installed by default.
RUN if [ "$INCLUDE_ML" = "true" ]; then \
        uv sync --frozen --extra ml --no-install-project; \
    else \
        uv sync --frozen --no-install-project; \
    fi \
    && chown -R appuser:appuser /opt/venv

COPY --chown=appuser:appuser . .

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --reload"]
