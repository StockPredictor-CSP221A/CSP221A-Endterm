# Application
APP_NAME="Stock Predictor API"
VERSION=0.1.0

# JSON array of allowed frontend origins.
# Local dev: http://localhost:5173
# Production (Modal secret): CORS_ORIGINS=["https://stock-predictor-omega-five.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (psycopg 3 driver).
# Local fallback:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_predictor
# Neon: copy the *pooled* connection string from the Neon dashboard and paste it
# here. The app rewrites postgres:// or postgresql:// to postgresql+psycopg://.
# Keep ?sslmode=require in the URL. In production this lives in the Modal secret
# `stock-predictor-api`; never commit the real URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_predictor

DEFAULT_HISTORY_PERIOD=1y
