# Application
APP_NAME="PrognoStock API"
VERSION=0.1.0

# JSON array of allowed frontend origins.
# Local dev: http://localhost:5173
# Production (Modal secret): CORS_ORIGINS=["https://stock-predictor-omega-five.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (psycopg 3 driver).
# Local fallback:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_predictor
# Neon: copy the *pooled* connection string from the Neon dashboard and paste it
# here. The app rewrites postgres:// or postgresql:// to postgresql+psycopg://.
# Keep ?sslmode=require in the URL. In production this lives in the Modal secret
# `stock-predictor-api`; never commit the real URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_predictor

DEFAULT_HISTORY_PERIOD=1y

# Auth (JWT access tokens, Argon2 password hashes).
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production this lives in the Modal secret `stock-predictor-api`.
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
# 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Social sign-in (optional). Leave a provider blank to hide its button.
# Google: Google Cloud console > APIs & Services > Credentials > OAuth client ID
# (type "Web application"). Add each frontend origin under
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# GitHub: Settings > Developer settings > OAuth Apps. Set the callback URL to
# <frontend origin>/auth/github/callback. GitHub allows one callback URL per
# app, so use one app for local dev and another for production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
